# ============================================
# Emotion-Echo 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ============================================

# --------------------------------------------
# 基础配置：前端只连 APISIX 网关
#
# 架构（决策 11/12）：
#   浏览器 → APISIX :19080 → BFF :8894 → 5 个业务 svc
#   鉴权(jwt-auth) / 限流 / 熔断 / CORS 只在 APISIX 做；
#   APISIX 验签后注入 X-User-Id，BFF 与下游信任该 header。
#   前端**不要**直连 BFF 或某个业务 svc——那会绕过鉴权层。
#
# 2026-09-04 修正：本模板原写 user-svc 直连 :8888（Stage 26-Q 为绕开 APISIX 3.9
# 的 nginx 301 bug 的临时方案）。现镜像 3.18.0，301 不复现；且 Stage 33 PR-20
# 收紧端口后 user-svc / chat-svc / assessment-svc / analytics-svc 都不再对宿主
# 暴露，:8888 实测 HTTP 000——照原模板配置的新环境，前端一个请求都发不出去。
#
# 注意：APISIX 需先 seed 路由才可用（bash deploy/apisix/seed.sh），
# 否则所有请求 404（routes 数为 0）。
# --------------------------------------------

NUXT_PUBLIC_API_BASE_URL=http://localhost:19080/api/v1

# 请求超时时间（毫秒）
NUXT_PUBLIC_REQUEST_TIMEOUT=10000

# --------------------------------------------
# AI 服务配置
# --------------------------------------------

# AI 流式接口地址
NUXT_PUBLIC_AI_STREAM_API=/ai/stream

# 默认使用的 LLM 模型
NUXT_PUBLIC_LLM_MODEL=gpt-4

# AI 服务 API Key（仅服务端需要）
# AI_API_KEY=your_api_key_here

# --------------------------------------------
# 应用配置
# --------------------------------------------

# 应用名称
NUXT_PUBLIC_APP_NAME=情绪回音

# 应用版本
NUXT_PUBLIC_APP_VERSION=1.0.0

# 是否开启调试模式
NUXT_PUBLIC_DEBUG=true

# --------------------------------------------
# 第三方登录配置（已废弃）
# --------------------------------------------
# Stage 62 PR-5: 微信/QQ OAuth 路径已弃用（ADR 21，wechat-qq-login-and-upload.md
# superseded-by Stage 38-A）。如未来需重新接入 OAuth，按 ADR 21 §C 走撤销流程。

# --------------------------------------------
# 存储配置（可选）
# --------------------------------------------

# 本地存储前缀（避免多项目冲突）
NUXT_PUBLIC_STORAGE_PREFIX=emotion_echo_

# 消息缓存上限（条/会话）
NUXT_PUBLIC_MESSAGE_CACHE_LIMIT=500

# --------------------------------------------
# 调试配置（开发环境使用）
# --------------------------------------------

# 是否禁用登录拦截（true=禁用，false=启用）
# 注意：生产环境必须设置为 false 或删除此配置
NUXT_PUBLIC_DISABLE_AUTH=false

# --------------------------------------------
# 安全相关（仅服务端）
# --------------------------------------------

# JWT 密钥（生产环境必须修改）
# JWT_SECRET=your_secret_here

# 刷新 Token 有效期（天）
# REFRESH_TOKEN_EXPIRES=7

# Access Token 有效期（分钟）
# ACCESS_TOKEN_EXPIRES=15
