# ============================================================
#  Emotion-Echo 本地覆盖环境变量模板
# ============================================================
# 复制本文件为 `deploy/.env.local`（路径必须），docker compose 会自动加载。
# 真实 deploy/.env.local 永远不入 git（见 .gitignore `*.env.*.local`）。
#
# Stage 36-B1 / G5：真实 LLM 接入（DeepSeek / OpenAI / 其他兼容 OpenAI 协议的 provider）
# --------------------------------------------------------------
# DeepSeek 注册即送 credits：https://platform.deepseek.com/
# OpenAI 注册付费：https://platform.openai.com/
#
# 空 LLM_API_KEY → ai-svc LLMFuser 自动走 fallback（late_fuser_weighted 单模态）
# 非空          → ai-svc 调真实 LLM，FusionWorker 日志会出现 "[fusion] LLM fuser active"
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=3

# Stage 30 / BFF: 真实 LLM 接入（BFF ai_stream handler 读 BFF_ 前缀；
# 与 ai-svc 共用同一 key，但语义边界用前缀区分）
BFF_LLM_API_KEY=
BFF_LLM_BASE_URL=https://api.deepseek.com
BFF_LLM_MODEL=deepseek-chat

# Stage 22-A: 多模态 AI profile（可选，启动 FER/SenseVoice 镜像时需要）
# FER_BASE_URL=http://emotion-echo-fer:8004
# SENSEVOICE_BASE_URL=http://emotion-echo-sensevoice:8002
# XTTS_BASE_URL=http://emotion-echo-xtts:8003
