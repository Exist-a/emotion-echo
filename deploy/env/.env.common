# =====================================================
#  Emotion-Echo 分布式基础设施 · 公共环境变量
#
#  ⚠️ 本文件已腐烂（2026-09-18 E2E-05 实测）：
#    - APISIX_VERSION 与 docker-compose.infra.yml 不一致（3.9.0 vs 3.18.0）
#    - GIN_BACKEND_HOST 指向已迁入 legacy/ 的 Gin（compose 不引用）
#  真实版本来源 = docker-compose.infra.yml 中的 image: 行。
#  本文件保留供未来 Stage 1.x+ 统一版本管理使用。
# =====================================================

# 镜像版本（⚠️ 以下版本仅供参考，真实值以 docker-compose.infra.yml 为准）
POSTGRES_VERSION=15-alpine
REDIS_VERSION=7-alpine
SKYWALKING_VERSION=9.7.0
APISIX_VERSION=3.18.0-debian  # Stage 32 更新（原 3.9.0 已过时）
KAFKA_VERSION=3.6

# SkyWalking 配置
SKYWALKING_STORAGE=h2                  # dev 使用 h2，生产换 elasticsearch
SW_OAP_PORT=11800                      # gRPC
SW_UI_PORT=12800                       # HTTP（UI 查询）
SW_FRONTEND_PORT=18080                 # 映射到宿主机

# APISIX 配置
APISIX_PORT=9080                       # 网关入口
APISIX_ADMIN_PORT=9180                 # Admin API（Stage 1.3+ 启用）

# Kafka 配置
KAFKA_BROKER_PORT=9092
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m

# ⚠️ 以下 Gin 配置已过时 — Gin 已迁入 legacy/，compose 不再引用
# GIN_BACKEND_HOST=host.docker.internal
# GIN_BACKEND_PORT=8080
