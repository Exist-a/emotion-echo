# ============================================================
#  Emotion-Echo 本地覆盖环境变量（dev only，gitignored）
#  路径必须：deploy/.env.local（不在 deploy/env/ 下！）
#  Docker compose 自动加载
# ============================================================

# --- Stage 36-D Bug 4: 本地 LLM 接入（ai-svc 用） ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=3

# --- BFF ai_stream 调用的真实 LLM（与 ai-svc 共享同一 key；BFF 走 BFF_ 前缀） ---
BFF_LLM_API_KEY=
BFF_LLM_BASE_URL=https://api.deepseek.com
BFF_LLM_MODEL=deepseek-chat

# --- ai-svc <-> llm-service 内部鉴权（mTLS 替代） ---
LLM_INTERNAL_API_KEY=dev-key-change-me-please-32chars-min
INTERNAL_API_KEY=dev-key-change-me-please-32chars-min
# 是否强制要求 INTERNAL_API_KEY（dev 默认 0,prod 设为 1）
INTERNAL_API_KEY_REQUIRED=0

# --- Stage 22-A: 多模态 AI profile（可选，启动 FER/SenseVoice 镜像时需要） ---
# FER_BASE_URL=http://emotion-echo-fer:8004
# SENSEVOICE_BASE_URL=http://emotion-echo-sensevoice:8002
# XTTS_BASE_URL=http://emotion-echo-xtts:8003

# --- 用法 ---
#   1. cp deploy/env/.env.local.example deploy/.env.local
#   2. 编辑 LLM_API_KEY=sk-... 和 BFF_LLM_API_KEY=sk-...
#   3. cd deploy && docker compose -f docker-compose.infra.yml -f docker-compose.apps.yml up -d
#   4. ai-svc 和 BFF 自动读到 key，无需 --env-file
#
# 注意：deploy/.env.local 在 .gitignore（*.env.*.local）），所以不会 commit 到仓库。