# deploy/apisix/services.env.example
#
# Sprint 1 PR-3 (2026-09-04): dev 默认服务 host:port 配置
#
# 用途：deploy/apisix/seed.sh 启动时通过 _load_services() 自动 source 本文件（如果存在）；
#      prod 部署通过 `services.env` (git ignore) 覆盖 host:port + JWT_SECRET + CORS。
#
# 命名约定：
#   - <svc>_HOST  容器内 DNS 名（或外部 IP / FQDN）
#   - <svc>_PORT  业务端口
#   - APISIX_<X>  APISIX 自身配置（admin url/key, jwt secret, cors）
#
# E2E-F-114 (2026-09-22)：所有赋值必须写成 ${VAR:-default} 形式。
# plain 赋值（VAR=default）在 source 时会**覆盖调用方显式传入的真值**
# （显式 env / compose environment 注入的 BFF_JWT_SECRET 都被挪成占位符），
# 与文件头声明的优先级"用户传入 env > services.env > example"直接矛盾。
#
# 与 charts/emotion-echo/charts/apisix/values.yaml 的 nacos-discovery 段对齐
# （seed.sh 把 host/port 写进 upstream.discovery_args，prod 走 K8s Service FQDN）。

# ============ APISIX 自身 ============
APISIX_ADMIN_URL=${APISIX_ADMIN_URL:-http://localhost:9180}
# E2E-F-69：此处原先是**真实可用**的管理员密钥（仓库 public）⇒ 已轮换为占位符。
# 真值只放 deploy/.env.local（gitignored），容器用 --env-file 注入；
# HOST 侧由 seed.sh 的 _load_env_local() 自动取 .env.local（E2E-F-114）。
# 注意 config.yaml 的 admin_key 必须与这里一致（APISIX 3.18 不支持在 admin_key 处做 env 替换）。
APISIX_ADMIN_KEY=${APISIX_ADMIN_KEY:-dev-admin-key-local-only}
# 同上：JWT 签名密钥不得内联真值（泄露即可伪造任意用户身份）
BFF_JWT_SECRET=${BFF_JWT_SECRET:-dev-jwt-secret-local-only}
CORS_ALLOW_ORIGINS=${CORS_ALLOW_ORIGINS:-http://localhost:3000,http://127.0.0.1:3000}

# ============ 业务 svc 容器 DNS + 端口（dev 单节点）============
USER_SVC_HOST=${USER_SVC_HOST:-emotion-echo-user-svc}
USER_SVC_PORT=${USER_SVC_PORT:-8888}

CHAT_SVC_HOST=${CHAT_SVC_HOST:-emotion-echo-chat-svc}
CHAT_SVC_PORT=${CHAT_SVC_PORT:-8890}

ASSESSMENT_SVC_HOST=${ASSESSMENT_SVC_HOST:-emotion-echo-assessment-svc}
ASSESSMENT_SVC_PORT=${ASSESSMENT_SVC_PORT:-8889}

ANALYTICS_SVC_HOST=${ANALYTICS_SVC_HOST:-emotion-echo-analytics-svc}
ANALYTICS_SVC_PORT=${ANALYTICS_SVC_PORT:-8893}

AI_SVC_HOST=${AI_SVC_HOST:-emotion-echo-ai-svc}
AI_SVC_PORT=${AI_SVC_PORT:-8891}

WEB_BFF_HOST=${WEB_BFF_HOST:-emotion-echo-web-bff}
WEB_BFF_PORT=${WEB_BFF_PORT:-8894}

# ============ 容器探测 ============
# DOCKER_NETWORK 留空则退化为宿主机直连（兼容非 compose 部署）
DOCKER_NETWORK=${DOCKER_NETWORK:-emotion-echo_app-network}
PROBE_IMAGE=${PROBE_IMAGE:-curlimages/curl:latest}
