    {
      "type": "stat",
      "title": "DLQ Depth (chat-events-dlq messages) — alerting: DLQDepthHigh / DLQMessagesAccumulating",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "description": "E2E-22 语义修正: 原 expr 用 kafka_consumergroup_lag 按 topic 过滤，但 lag 是\"消费组落后量\"，DLQ 主题没有常驻 consumer（设计上为人工回放），因此该 series 恒不存在 → 面板永远 \"No data\"。改为 offset 求和 = 死信堆积条数，这才是运维要看的量；`or vector(0)` 保证主题尚未创建时显示 0 而非空白。2026-09-29 实测原 expr series=0。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(kafka_topic_partition_current_offset{topic=\"chat-events-dlq\"} - kafka_topic_partition_oldest_offset{topic=\"chat-events-dlq\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "{{consumergroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      }
    },
