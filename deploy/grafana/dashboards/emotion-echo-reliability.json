{
 "uid": "emotion-echo-reliability",
 "title": "Emotion-Echo · 可靠性面（DLQ / Outbox / 就绪）",
 "tags": [
  "cl-01",
  "reliability"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
