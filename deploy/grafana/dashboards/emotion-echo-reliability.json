 "description": "CL-01 Phase 7 · 可靠性面看板。覆盖 DLQ 黑洞、outbox 静默回退、就绪探针、5xx 速率。\n注意 `outbox_sent_via_fallback_total > 0` 是**下游全链路静默失效**的早期信号。",
 "panels": [
  {
   "type": "stat",
   "title": "Outbox 死信行",
   "id": 1,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(emotion_echo_outbox_events_dead_total) or vector(0)",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "description": "chat-svc outbox 重试耗尽的行数。>0 = 有事件永远发不出去。"
  },
  {
   "type": "stat",
   "title": "Outbox 走内存回退",
   "id": 2,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(emotion_echo_outbox_sent_via_fallback_total) or vector(0)",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "description": "**重要**：>0 表示 Kafka producer 初始化失败、outbox 静默改投内存 ⇒\n**后续事件不会进 Kafka，下游 consumer 全部收不到**（2026-10-14 实测该值为 1）。"
  },
  {
   "type": "stat",
   "title": "DLQ 投递失败（5m）",
   "id": 3,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(increase(emotion_echo_dlq_publish_total{result=\"failure\"}[5m])) + sum(increase(emotion_echo_analytics_dlq_publish_total{result=\"failure\"}[5m])) or vector(0)",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "description": "业务消息已 MarkMessage 前进、DLQ 也没收到 = 事件彻底丢失（双失败黑洞）。"
  },
  {
   "type": "stat",
