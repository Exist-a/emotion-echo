# ============================================================
# Emotion-Echo monorepo · .gitignore
# ============================================================
# 主仓根目录 .gitignore，覆盖根级 + 所有 Go/Node/Python 子项目。
# 单仓 monorepo（无 submodule，见 git-layout §一）。以下目录曾为 submodule、现为普通目录：
# emotion-echo-web / legacy/emotion-echo-gin /
# emotion-echo-models/sensevoice-small / emotion-echo-models/XTTS/TTS

# ---------- 通用 ----------
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
*.swp
*.swo
*~
.idea/
.vscode/
.trae/
.cursor/
*.iml
# Docker 清理脚本运行时生成的备份清单（每次跑 cleanup_docker.sh 都会重新生成）
docker-images-before.txt

# ---------- Go ----------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/
coverage.txt
coverage.html
*.coverprofile
# Go 编译产物（无后缀的可执行文件）
/legacy/emotion-echo-gin/server
/server
/bin/

# ---------- Node / Nuxt ----------
node_modules/
.nuxt/
.output/
.cache/
.next/
.parcel-cache/
dist/
build/
*.tsbuildinfo

# ---------- 资源/模型文件（二进制，体积大，运行时按需下载） ----------
*.vrm
*.gltf
*.glb
*.fbx
*.obj
*.ttf
*.woff
*.woff2
*.eot

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.eggs/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/
venv/
.venv/
# env/                  # Stage 36-D: deploy/env/.env.local.example needs git; tracked explicitly below
ENV/

# ---------- 运行时数据 / 数据库 ----------
.postgres/
*.db
*.sqlite
*.sqlite3
pg_log.txt

# ---------- 散落的 proto 生成物（P1-D 规范化前的临时方案） ----------
/*.pb.go
/*_grpc.pb.go

# ---------- AI 模型权重（体积过大，禁止入仓） ----------
*.pth
*.onnx
*.pt
*.bin
*.safetensors
*.h5
*.keras
*.tflite
*.engine
*.trt
*.bpe.model
*.bpe
# XTTS-v2 模型目录（约 2GB，从 ModelScope 自动下载）
emotion-echo-models/XTTS/AI-ModelScope/
emotion-echo-models/**/AI-ModelScope/
# SenseVoice 模型目录（约 200MB，从 ModelScope 自动下载）
emotion-echo-models/sensevoice-small/am.mvn
emotion-echo-models/sensevoice-small/model.pt
emotion-echo-models/sensevoice-small/chn_jpn_yue_eng_ko_spectok.bpe.model

# ---------- 工具链 / 第三方二进制 ----------
protoc-dist/
protoc.zip
*.zip
*.tar.gz

# ---------- 证书 / 密钥 ----------
*.pem
*.key
*.crt
*.p12
deploy/certs/
.env.local
.env.*.local

# ---------- 临时 / 输出 ----------
tmp/
out/
artifacts/
*.bak
*.orig

# ---------- IDE / 工具 ----------
*.code-workspace
.history/
*.tgz

# ---------- Agent / 编辑器状态 ----------
# ZCode agent session plans (transient)
.zcode/

# ---------- Test artifacts (Playwright / pytest reports) ----------
# Playwright HTML reporter output
playwright-report/
# Playwright per-test artifact dir
test-results/
# pytest 缓存 / python __pycache__
.pytest_cache/
__pycache__/
# test_seed_nacos.sh 临时响应体（Git Bash /tmp 跨 curl.exe/python.exe 不通用）
deploy/apisix/.tmp-seedtest/

# ---------- Helm ----------
# Chart.lock 是 helm dependency build 生成的依赖锁，与 helm version 强绑定，
# 团队成员本地 helm 版本可能不同导致锁文件差异。按需手动提交（release pipeline 时）。
charts/**/Chart.lock